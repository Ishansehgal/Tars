<?xml version="1.0" ?>
<robot name="tars_robot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="trans_center_linear">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="joint_center_linear">
    <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
  </joint>
  <actuator name="motor_center_linear">
    <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

<transmission name="trans_left_leg">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="joint_left_leg">
    <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
  </joint>
  <actuator name="motor_left_leg">
    <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

<transmission name="trans_right_leg">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="joint_right_leg">
    <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
  </joint>
  <actuator name="motor_right_leg">
    <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

</robot>
