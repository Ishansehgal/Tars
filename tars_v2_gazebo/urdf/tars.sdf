    <link name="left_leg">
      <pose>0 0 -0.585 0 0 0</pose> <inertial>
        <mass>5.0</mass> <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.5714</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>0.5745</iyy> <iyz>0</iyz>
          <izz>0.0052</izz>
